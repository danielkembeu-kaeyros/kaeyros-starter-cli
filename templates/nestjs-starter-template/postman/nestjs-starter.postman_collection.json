    {
      "name": "07 Files (needs S3 configured)",
      "item": [
        {
          "name": "POST /files (upload)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  pm.test('File uploaded', () => pm.expect(pm.response.json().id).to.be.a('string'));",
                  "  pm.collectionVariables.set('fileId', pm.response.json().id);",
                  "} else {",
                  "  pm.test('Upload failed — S3 is probably not configured (got ' + pm.response.code + ')', () => {",
                  "    pm.expect([400, 500, 502, 503]).to.include(pm.response.code);",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "file", "type": "file", "src": "postman/sample.png" }]
            },
            "url": { "raw": "{{baseUrl}}/files", "host": ["{{baseUrl}}"], "path": ["files"] }
          }
        },
        {
          "name": "GET /files/me",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Own files list returns 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/files/me",
              "host": ["{{baseUrl}}"],
              "path": ["files", "me"]
            }
          }
        },
        {
          "name": "GET /files/:id/download",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["if (!pm.collectionVariables.get('fileId')) pm.execution.skipRequest();"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Presigned download URL returned', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/files/{{fileId}}/download",
              "host": ["{{baseUrl}}"],
              "path": ["files", "{{fileId}}", "download"]
            }
          }
        },
        {
          "name": "DELETE /files/:id",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["if (!pm.collectionVariables.get('fileId')) pm.execution.skipRequest();"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('File deleted', () => pm.response.to.have.status(204));",
                  "pm.collectionVariables.set('fileId', '');"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/files/{{fileId}}",
              "host": ["{{baseUrl}}"],
              "path": ["files", "{{fileId}}"]
            }
          }
        }
      ]
