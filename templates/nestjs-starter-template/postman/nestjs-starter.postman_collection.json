                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Email verified', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{manualEmail}}\",\n  \"code\": \"{{manualCode}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/verify-email/code",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "verify-email", "code"]
            }
          }
        },
