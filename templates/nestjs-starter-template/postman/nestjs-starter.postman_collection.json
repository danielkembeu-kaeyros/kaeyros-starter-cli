{
  "info": {
    "name": "NestJS Starter API — E2E",
    "description": "Automated smoke test of every endpoint.\n\nRun order matters: Auth core flow first (captures {{accessToken}}, transparently handles the seeded super-admin's forced first-login password change), then admin CRUD chains (permission → role → account), users, audit, files, cleanup.\n\nThe '99 Manual — emailed token flows' folder is skipped unless the environment variable runManual=true, because those endpoints need a token/code delivered by email (preview mode prints an Ethereal URL in the server logs).\n\nNote: the whole /auth surface is rate-limited to 10 requests/min — the automated flow stays under that, but avoid re-running the Auth folder repeatedly within a minute.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "accessToken", "value": "" },
    { "key": "mustChangePassword", "value": "false" },
    { "key": "permissionId", "value": "" },
    { "key": "roleId", "value": "" },
    { "key": "accountId", "value": "" },
    { "key": "fileId", "value": "" },
    { "key": "testUserEmail", "value": "" },
    { "key": "registerEmail", "value": "" }
  ],
  "item": [
    {
      "name": "00 Health",
      "item": [
        {
          "name": "GET /health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Health check returns 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        }
      ]
    },
    {
      "name": "01 Auth — core flow",
      "item": [
        {
          "name": "POST /auth/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login returns 200 with accessToken', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().accessToken).to.be.a('string');",
                  "});",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', json.accessToken);",
                  "pm.collectionVariables.set('mustChangePassword', String(json.user && json.user.mustChangePassword === true));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "POST /auth/change-initial-password (first run only)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Only needed when the seeded super-admin still has mustChangePassword=true",
                  "if (pm.collectionVariables.get('mustChangePassword') !== 'true') pm.execution.skipRequest();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Initial password changed', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  // From now on the working password is adminNewPassword — persist it",
                  "  pm.environment.set('adminPassword', pm.variables.replaceIn('{{adminNewPassword}}'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{adminPassword}}\",\n  \"newPassword\": \"{{adminNewPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/change-initial-password",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "change-initial-password"]
            }
          }
        },
        {
          "name": "POST /auth/login (re-login after password change)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.collectionVariables.get('mustChangePassword') !== 'true') pm.execution.skipRequest();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Re-login returns 200 with accessToken', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().accessToken).to.be.a('string');",
                  "});",
                  "pm.collectionVariables.set('accessToken', pm.response.json().accessToken);",
                  "pm.collectionVariables.set('mustChangePassword', 'false');"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "GET /auth/me",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Me returns the admin account', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().email.toLowerCase()).to.eql(pm.variables.replaceIn('{{adminEmail}}').toLowerCase());",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        },
        {
          "name": "POST /auth/refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Refresh rotates the access token (cookie-based)', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().accessToken).to.be.a('string');",
                  "});",
                  "pm.collectionVariables.set('accessToken', pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh"]
            }
          }
        },
        {
          "name": "POST /auth/register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('registerEmail', `e2e.register.${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Register accepted (verification email queued)', () => {",
                  "  pm.expect([200, 201]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{registerEmail}}\",\n  \"password\": \"E2eTesting!2345\",\n  \"firstName\": \"E2e\",\n  \"lastName\": \"Register\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        }
      ]
    },
    {
      "name": "02 Admin · Permissions",
      "item": [
        {
          "name": "POST /admin/permissions",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.test('Permission created', () => pm.expect(pm.response.json().id).to.be.a('string'));",
                  "  pm.collectionVariables.set('permissionId', pm.response.json().id);",
                  "} else {",
                  "  pm.test('Permission already exists from a previous run (409)', () => pm.response.to.have.status(409));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"e2etest:read\",\n  \"resource\": \"e2etest\",\n  \"action\": \"read\",\n  \"description\": \"Created by the Postman e2e collection — safe to delete\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/permissions",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "permissions"]
            }
          }
        },
        {
          "name": "GET /admin/permissions",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Permissions list returns 200', () => pm.response.to.have.status(200));",
                  "// Fallback: recover the id if create hit a 409 from an aborted previous run",
                  "if (!pm.collectionVariables.get('permissionId')) {",
                  "  const all = pm.response.json();",
                  "  const rows = Array.isArray(all) ? all : (all.data || all.items || []);",
                  "  const mine = rows.find(p => p.name === 'e2etest:read');",
                  "  if (mine) pm.collectionVariables.set('permissionId', mine.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/permissions",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "permissions"]
            }
          }
        },
        {
          "name": "GET /admin/permissions/:id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Permission fetched by id', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().name).to.eql('e2etest:read');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/permissions/{{permissionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "permissions", "{{permissionId}}"]
            }
          }
        }
      ]
    },
