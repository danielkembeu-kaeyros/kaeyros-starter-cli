    {
      "name": "99 Manual — emailed token flows",
      "description": "These endpoints need a token/code delivered by email (or SMS). With EMAIL_PREVIEW_MODE=true the server logs print an Ethereal preview URL for every email — grab the code/token there, fill manualEmail / manualToken / manualCode in the environment, set runManual=true, and run this folder.\n\nReminder: /auth is throttled at 10 requests/min.",
      "item": [
        {
          "name": "POST /auth/resend-verification",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.environment.get('runManual') !== 'true') pm.execution.skipRequest();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Always 200 (silent)', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{manualEmail}}\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/auth/resend-verification",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "resend-verification"]
            }
          }
        },
        {
          "name": "POST /auth/verify-email/code",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
