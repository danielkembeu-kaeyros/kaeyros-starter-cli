# =============================================================================
# Environment validation (fail-fast)
# -----------------------------------------------------------------------------
# The app validates this environment at startup (src/config/env.validation.ts).
# If a required variable is missing or malformed the process refuses to boot and
# prints a single aggregated error listing every problem.
#
# Always required:           DATABASE_URL
# Required in staging/prod:   JWT_SECRET, JWT_REFRESH_SECRET (>= 32 chars), plus
#                             credentials for the selected providers:
#                               STORAGE_PROVIDER=s3   -> S3_* (or AWS_* fallback)
#                               SMS_PROVIDER=twilio   -> TWILIO_*
#                               EMAIL_PROVIDER=smtp   -> SMTP_HOST/USER/PASS
#                               EMAIL_PROVIDER=sendgrid -> SENDGRID_API_KEY
# Development / test stay frictionless: only DATABASE_URL is mandatory.
# =============================================================================

# Application
NODE_ENV=development
APP_ENV=development  # development | staging | production
PORT=3000
API_PREFIX=api

# Database
# REQUIRED: Application will not start without this
DATABASE_URL=postgresql://user:password@localhost:5432/nestjs_starter?schema=public

# Test Database
# REQUIRED for running tests: Used by test suite
DATABASE_URL_TEST=postgresql://user:password@localhost:5432/nestjs_starter_test?schema=public

# JWT
# REQUIRED in production: Must be set in production environments
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=15m
# REQUIRED in production: Must be set in production environments
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Rate Limiting / Throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Logging
LOG_LEVEL=info
LOG_FILE_ENABLED=true
LOG_FILE_PATH=logs/application.log
LOG_DB_ENABLED=true

# Health Check
HEALTH_CHECK_ENABLED=true

# Swagger/OpenAPI
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# Sentry
SENTRY_DSN=
SENTRY_ENABLED=false
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=${APP_ENV}
SENTRY_RELEASE=
SENTRY_DEBUG=false

# Monitoring
ENABLE_METRICS=true
ENABLE_TRACING=true
ENABLE_PROFILING=false

# Security
BCRYPT_ROUNDS=12
EMAIL_VERIFICATION_TTL_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=60
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_DURATION_MINUTES=15
VERIFICATION_CODE_LENGTH=6
LOGIN_OTP_TTL_MINUTES=5

# Initial super-admin (used once by `npm run db:seed` on a fresh database)
# Required if no SUPER_ADMIN account exists yet. The seeded account is created
# with mustChangePassword=true and must change its password on first login.
# Password policy: min 10 chars, upper + lower + digit + symbol.
INITIAL_SUPER_ADMIN_EMAIL=
INITIAL_SUPER_ADMIN_PASSWORD=

# AWS S3 (legacy — used only by winston log archival until phase 10)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=

# Storage provider (S3-backed by default; local / cloudinary / azure are drop-ins)
STORAGE_PROVIDER=s3
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
STORAGE_MAX_UPLOAD_BYTES=10485760
STORAGE_ALLOWED_MIME=image/png,image/jpeg,image/webp,image/gif,application/pdf

# Retention (consumed by JobsModule crons)
LOG_ARCHIVE_AFTER_DAYS=30
AUDIT_ARCHIVE_AFTER_DAYS=30
AUDIT_RETENTION_DAYS=90

# Email Configuration
EMAIL_PROVIDER=smtp # smtp | ses | sendgrid
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=NestJS Starter
EMAIL_PREVIEW_MODE=true # Set to false in production

# SMTP Configuration (for EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password

# AWS SES Configuration (for EMAIL_PROVIDER=ses)
# Uses AWS credentials from above or specify separately:
# AWS_SES_ACCESS_KEY_ID=
# AWS_SES_SECRET_ACCESS_KEY=
# AWS_SES_REGION=us-east-1

# SendGrid Configuration (for EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=

# SMS provider (used by OTP login when an account opts in via SMS)
SMS_PROVIDER=twilio          # twilio | null
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000

# Internationalization (i18n)
I18N_DEFAULT_LANGUAGE=en
I18N_FALLBACK_LANGUAGE=en
I18N_SUPPORTED_LANGUAGES=en,fr
