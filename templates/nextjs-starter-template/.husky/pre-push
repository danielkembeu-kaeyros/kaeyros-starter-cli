#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running pre-push checks..."

# Run type checking
echo "⚙️  Type checking..."
npm run type-check

# Run linting
echo "🧹 Linting..."
npm run lint

# Run format check
echo "✨ Checking code formatting..."
npm run format:check

echo "✅ All pre-push checks passed!"
