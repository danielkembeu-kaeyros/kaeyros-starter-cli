<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>Your admin account</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #f5f6fa;
        font-family:
          -apple-system,
          BlinkMacSystemFont,
          'Segoe UI',
          Roboto,
          'Helvetica Neue',
          Arial,
          sans-serif;
        color: #1f2937;
        line-height: 1.6;
      }
      .wrapper {
        width: 100%;
        padding: 32px 16px;
        box-sizing: border-box;
      }
      .card {
        max-width: 560px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 12px;
        padding: 40px 36px;
        box-shadow: 0 4px 10px rgba(31, 41, 55, 0.06);
      }
      .brand {
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        color: #6366f1;
        margin: 0 0 24px;
      }
      h1 {
        font-size: 22px;
        font-weight: 600;
        color: #1f2937;
        margin: 0 0 16px;
      }
      p {
        margin: 0 0 16px;
        font-size: 15px;
        color: #374151;
      }
      .muted {
        color: #6b7280;
        font-size: 13px;
      }
      .credentials {
        background: #f3f4f6;
        border-radius: 10px;
        padding: 20px 24px;
        margin: 24px 0;
      }
      .credentials dt {
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #6b7280;
        margin-bottom: 4px;
      }
      .credentials dd {
        font-family: 'SF Mono', 'Menlo', 'Consolas', monospace;
        font-size: 16px;
        font-weight: 600;
        color: #1f2937;
        margin: 0 0 16px;
        word-break: break-all;
      }
      .credentials dd:last-child {
        margin-bottom: 0;
      }
      .btn {
        display: inline-block;
        background: #6366f1;
        color: #ffffff !important;
        text-decoration: none;
        font-weight: 600;
        font-size: 15px;
        padding: 12px 22px;
        border-radius: 8px;
        margin: 8px 0;
      }
      .notice {
        background: #fef3c7;
        border-radius: 10px;
        padding: 14px 18px;
        font-size: 14px;
        color: #92400e;
        margin: 24px 0;
      }
      .divider {
        height: 1px;
        background: #e5e7eb;
        border: 0;
        margin: 32px 0 24px;
      }
      .footer {
        text-align: center;
        font-size: 12px;
        color: #9ca3af;
        margin-top: 24px;
      }
      .center {
        text-align: center;
      }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <div class="card">
        <p class="brand">Administrator invitation</p>
        <h1>Hello{{#if userName}}, {{userName}}{{/if}}.</h1>
        <p>
          {{#if invitedBy}}{{invitedBy}}{{else}}A super admin{{/if}} has created an
          administrator account for you. Sign in with the credentials below.
        </p>

        <dl class="credentials">
          <dt>Email</dt>
          <dd>{{email}}</dd>
          <dt>Temporary password</dt>
          <dd>{{temporaryPassword}}</dd>
        </dl>

        <p class="center">
          {{#if loginUrl}}
            <a class="btn" href="{{loginUrl}}">Sign in and set your password</a>
          {{/if}}
        </p>

        <div class="notice">
          <strong>First sign-in is required:</strong> you'll be prompted to choose a new
          password before you can use the rest of the dashboard.
        </div>

        <hr class="divider" />
        <p class="muted">
          If you weren't expecting this invitation, please contact your administrator.
        </p>
      </div>
      <p class="footer">&copy; {{currentYear}} NestJS Starter</p>
    </div>
  </body>
</html>
