<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>Your admin account is ready</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #f5f6fa;
        font-family:
          -apple-system,
          BlinkMacSystemFont,
          'Segoe UI',
          Roboto,
          'Helvetica Neue',
          Arial,
          sans-serif;
        color: #1f2937;
        line-height: 1.6;
      }
      .wrapper { width: 100%; padding: 32px 16px; box-sizing: border-box; }
      .card {
        max-width: 560px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 12px;
        padding: 40px 36px;
        box-shadow: 0 4px 10px rgba(31, 41, 55, 0.06);
      }
      .brand {
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        color: #6366f1;
        margin: 0 0 24px;
      }
      h1 { font-size: 22px; font-weight: 600; color: #1f2937; margin: 0 0 16px; }
      p { margin: 0 0 16px; font-size: 15px; color: #374151; }
      .muted { color: #6b7280; font-size: 13px; }
      .btn {
        display: inline-block;
        background: #6366f1;
        color: #ffffff !important;
        text-decoration: none;
        font-weight: 600;
        font-size: 15px;
        padding: 12px 22px;
        border-radius: 8px;
        margin: 8px 0;
      }
      .info {
        background: #eef2ff;
        border-radius: 10px;
        padding: 14px 18px;
        font-size: 14px;
        color: #4338ca;
        margin: 24px 0;
      }
      .divider {
        height: 1px;
        background: #e5e7eb;
        border: 0;
        margin: 32px 0 24px;
      }
      .footer {
        text-align: center;
        font-size: 12px;
        color: #9ca3af;
        margin-top: 24px;
      }
      .center { text-align: center; }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <div class="card">
        <p class="brand">Administrator invitation</p>
        <h1>Hello{{#if userName}}, {{userName}}{{/if}}.</h1>
        <p>
          {{#if invitedBy}}{{invitedBy}}{{else}}A super admin{{/if}} has created an
          administrator account for you at <strong>{{email}}</strong>.
        </p>

        <div class="info">
          <strong>This account uses one-time codes — no password required.</strong> Request a
          sign-in code each time you log in.
        </div>

        {{#if loginUrl}}
          <p class="center">
            <a class="btn" href="{{loginUrl}}">Request a sign-in code</a>
          </p>
        {{/if}}

        <hr class="divider" />
        <p class="muted">
          If you weren't expecting this invitation, please contact your administrator.
        </p>
      </div>
      <p class="footer">&copy; {{currentYear}} NestJS Starter</p>
    </div>
  </body>
</html>
