<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>Your sign-in code</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #f5f6fa;
        font-family:
          -apple-system,
          BlinkMacSystemFont,
          'Segoe UI',
          Roboto,
          'Helvetica Neue',
          Arial,
          sans-serif;
        color: #1f2937;
        line-height: 1.6;
      }
      .wrapper { width: 100%; padding: 32px 16px; box-sizing: border-box; }
      .card {
        max-width: 560px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 12px;
        padding: 40px 36px;
        box-shadow: 0 4px 10px rgba(31, 41, 55, 0.06);
      }
      .brand {
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        color: #6366f1;
        margin: 0 0 24px;
      }
      h1 { font-size: 22px; font-weight: 600; color: #1f2937; margin: 0 0 16px; }
      p { margin: 0 0 16px; font-size: 15px; color: #374151; }
      .muted { color: #6b7280; font-size: 13px; }
      .code-block {
        background: #f3f4f6;
        border-radius: 10px;
        padding: 20px 24px;
        margin: 28px 0;
        text-align: center;
      }
      .code {
        font-family: 'SF Mono', 'Menlo', 'Consolas', monospace;
        font-size: 30px;
        font-weight: 700;
        letter-spacing: 8px;
        color: #1f2937;
        margin: 0;
      }
      .divider {
        height: 1px;
        background: #e5e7eb;
        border: 0;
        margin: 32px 0 24px;
      }
      .footer {
        text-align: center;
        font-size: 12px;
        color: #9ca3af;
        margin-top: 24px;
      }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <div class="card">
        <p class="brand">Sign in</p>
        <h1>Your sign-in code{{#if userName}}, {{userName}}{{/if}}</h1>
        <p>Enter this code on the sign-in page to access your account.</p>

        <div class="code-block">
          <p class="code">{{code}}</p>
          <p class="muted" style="margin: 12px 0 0;">Expires in {{expiryMinutes}} minutes.</p>
        </div>

        <hr class="divider" />
        <p class="muted">
          If you didn't request this code, you can safely ignore this email — your account is
          not affected.
        </p>
      </div>
      <p class="footer">&copy; {{currentYear}} NestJS Starter</p>
    </div>
  </body>
</html>
